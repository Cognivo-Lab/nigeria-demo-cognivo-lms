# Cognivo LMS — environment configuration.
# Copy to .env (never commit real secrets). All variables are read and validated
# at boot; the server fails loudly naming any missing required variable.

# --- Runtime ---
PORT=8080
# demo  -> seeds a realistic catalogue + demo logins (owner/provider/learner)
# production -> starts empty and bootstraps an owner from OWNER_EMAIL below
APP_PROFILE=demo

# --- Database (required in production) ---
# Postgres connection string. When unset, an embedded in-process Postgres-
# compatible engine is used (zero-dependency local/CI/demo runs; not persistent).
# DATABASE_URL=postgres://user:password@localhost:5432/cognivo
# PG_POOL_MAX=10

# --- Seeded / first-run account password ---
# Password for demo accounts (demo profile) and the bootstrap owner. If unset a
# strong random value is generated and printed once to the server log.
SEED_PASSWORD=change-me-please

# --- Production first-run owner (APP_PROFILE=production) ---
# OWNER_EMAIL=owner@yourcompany.com
# OWNER_PASSWORD=   # falls back to SEED_PASSWORD when omitted

# --- White-label branding ---
BRAND_NAME=Cognivo LMS
BRAND_SUPPORT_EMAIL=support@cognivo.demo

# --- Optional: SSO (OpenID Connect). When unset, the SSO button is hidden and
# local login still works. Presets: Google / Microsoft Entra / Okta. ---
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-host/api/auth/callback/google

# --- Optional: SMTP for password-reset email (production) ---
# SMTP_URL=smtp://user:pass@smtp.host:587

# --- Optional: LLM-backed roadmap (Anthropic Claude). When unset the
# deterministic rule-based roadmap is used (no external calls). ---
# AI_API_KEY=

# --- Information governance ---
DATA_RESIDENCY=single-region
